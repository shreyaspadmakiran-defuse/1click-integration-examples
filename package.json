{
  "name": "defuse-1click-integration-example",
  "version": "0.1.0",
  "description": "End-to-end reference integration for the NEAR Intents 1Click API: typed client for every route, Shield incident checks, modular swap flows, and a CLI for interacting with all of it.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "1click": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "cli": "node -r ts-node/register src/cli/index.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"examples/**/*.ts\"",
    "lint": "eslint \"{src,test,examples}/**/*.ts\"",
    "test": "jest --testPathIgnorePatterns test/e2e",
    "test:watch": "jest --watch --testPathIgnorePatterns test/e2e",
    "test:e2e": "RUN_LIVE=1 jest test/e2e --runInBand",
    "example": "ts-node"
  },
  "keywords": [
    "near-intents",
    "1click",
    "defuse",
    "cross-chain",
    "swap"
  ],
  "license": "MIT",
  "dependencies": {
    "@defuse-protocol/one-click-sdk-typescript": "^0.1.24",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.1.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "prettier": "^2.3.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  },
  "jest": {
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@scure|@noble)/)"
    ],
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=20.18.0"
  }
}
