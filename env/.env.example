# Copy to env/.env.local and run with: NODE_ENV=local npm run cli -- tokens
# Everything here is optional. Public endpoints (/v0/tokens, /v0/quote,
# /v0/status) work with no credentials at all.

# Partner JWT from https://partners.near-intents.org/home
# Without it, every swap carries a 0.2% (20 bps) platform fee.
# ONE_CLICK_JWT=

# Partner API key, required only for signed intent execution
# (/v0/generate-intent and /v0/submit-intent, sent as X-API-Key).
# ONE_CLICK_API_KEY=

# Shield partner token (key_type SHIELD) from
# https://partners.near-intents.org/api-keys
# Required for "1click shield ..." and for the shield check in preflight.
# SHIELD_TOKEN=

# Overrides, rarely needed
# ONE_CLICK_BASE_URL=https://1click.chaindefuser.com
# SHIELD_BASE_URL=https://shield.chaindefuser.com
# LOG_LEVEL=info
